{
  "name": "@coupdecanon/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 vite dev --port 8000",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsx ./node_modules/payload/bin.js --disable-transpile build",
    "preview": "vite preview --port 8000",
    "check-types": "tsr generate && tsc --noEmit",
    "payload": "tsx ./node_modules/payload/bin.js --disable-transpile",
    "generate:types": "tsx ./node_modules/payload/bin.js --disable-transpile generate:types",
    "generate:importmap": "tsx ./node_modules/payload/bin.js --disable-transpile generate:importmap",
    "seed": "tsx ./node_modules/payload/bin.js --disable-transpile run ./src/payload/seed/index.ts",
    "migrate": "tsx ./node_modules/payload/bin.js --disable-transpile migrate",
    "migrate:create": "tsx ./node_modules/payload/bin.js --disable-transpile migrate:create"
  },
  "dependencies": {
    "@coupdecanon/config": "workspace:*",
    "@coupdecanon/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@medusajs/js-sdk": "2.21.2",
    "@payloadcms/db-postgres": "4.0.0-canary.37",
    "@payloadcms/email-nodemailer": "4.0.0-canary.37",
    "@payloadcms/richtext-lexical": "4.0.0-canary.37",
    "@payloadcms/tanstack-start": "4.0.0-canary.37",
    "@payloadcms/translations": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "graphql": "^16.14.2",
    "lucide-react": "^1.48.0",
    "nuqs": "2.10.1",
    "payload": "4.0.0-canary.37",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
